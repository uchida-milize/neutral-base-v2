# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cowork sandbox leftovers
_tmp_*

# Google Drive (FUSE) シャドウファイル — 開いたまま削除/置換されたファイルの残骸
.fuse_hidden*

# Claude Code / Cowork のローカル設定 (マシン固有・コミット不要)
.claude/settings.local.json
